# Copy to .env and export these before starting the server.
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
UNLARP_SECRET_KEY=change-me
UNLARP_DATABASE_URL=sqlite:///./unlarp.db
UNLARP_MEDIA_DIR=./media
UNLARP_DAILY_GENERATION_LIMIT=5
UNLARP_TOKEN_EXPIRE_MINUTES=10080
